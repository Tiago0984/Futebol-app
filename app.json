{
  "expo": {
    "name": "AACJ",
    "slug": "AACJapp",
    "owner": "aacj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aacjapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.aacj.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos para você escolher a foto do seu perfil.",
          "cameraPermission": "O app usa a câmera para você tirar a foto do seu perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D71920",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0209df90-30e2-4aff-a970-84412f822281"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0209df90-30e2-4aff-a970-84412f822281"
    }
  }
}
